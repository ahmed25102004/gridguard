
# PostgreSQL
POSTGRES_USER=gridguard
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=gridguard

# Redis
REDIS_PASSWORD=CHANGE_ME_LOCAL_ONLY

# EMQX Dashboard
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Backend database URL (Docker Compose overrides this)
DATABASE_URL=postgresql://gridguard:CHANGE_ME_LOCAL_ONLY@localhost:5432/gridguard

# JWT Security
JWT_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
