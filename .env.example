# PostgreSQL / Supabase Database Connection URL
# If using Supabase Connection Pooler (Transaction Mode, port 6543):
# DATABASE_URL=postgresql://postgres.your-project-id:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gridguard

# JWT Security Credentials
JWT_SECRET_KEY=gridguard-development-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
